<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_send_by_post" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="inside">
            <form t-if="sale_order.state in ('sale', 'done')"
                  t-attf-action="/my/orders/#{sale_order.id}/send_by_post" method="post"
                  class="d-flex gap-2 flex-lg-column flex-xl-row flex-wrap">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="access_token" t-att-value="access_token"/>
                <button type="submit" class="btn btn-light flex-grow-1 w-100">
                    <i class="fa fa-envelope-o me-1"/>Send me a paper copy
                </button>
            </form>
        </xpath>
    </template>

    <template id="sale_order_portal_send_by_post_message" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='introduction']" position="after">
            <div t-if="request.params.get('snailmail_sent')" class="alert alert-success" role="alert">
                Your paper copy has been queued for postal delivery.
            </div>
            <div t-if="request.params.get('snailmail_error')" class="alert alert-danger" role="alert">
                <t t-esc="request.params.get('snailmail_error')"/>
            </div>
        </xpath>
    </template>
</odoo>
