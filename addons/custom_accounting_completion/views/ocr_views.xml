<odoo>
    <record id="view_account_ocr_provider_config_list" model="ir.ui.view"><field name="name">account.ocr.provider.config.list</field><field name="model">account.ocr.provider.config</field><field name="arch" type="xml"><list><field name="name"/><field name="endpoint_url"/><field name="company_id"/><field name="active"/></list></field></record>
    <record id="view_account_ocr_provider_config_form" model="ir.ui.view"><field name="name">account.ocr.provider.config.form</field><field name="model">account.ocr.provider.config</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="endpoint_url"/><field name="api_key" password="True"/><field name="timeout"/><field name="max_file_size_mb"/></group></sheet></form></field></record>
    <record id="action_account_ocr_provider_config" model="ir.actions.act_window"><field name="name">OCR Provider Configuration</field><field name="res_model">account.ocr.provider.config</field><field name="view_mode">list,form</field></record>
    <record id="view_account_bill_digitization_provider_config" model="ir.ui.view"><field name="name">account.bill.digitization.provider.config</field><field name="model">account.bill.digitization</field><field name="inherit_id" ref="custom_accounting_ocr.view_account_bill_digitization_form"/><field name="arch" type="xml"><xpath expr="//field[@name='provider']" position="after"><field name="provider_config_id" invisible="provider != 'http_json'"/></xpath></field></record>
</odoo>
