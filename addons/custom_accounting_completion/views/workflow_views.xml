<odoo>
    <record id="view_custom_sales_inquiry_list" model="ir.ui.view"><field name="name">custom.sales.inquiry.list</field><field name="model">custom.sales.inquiry</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="partner_id"/><field name="state"/><field name="quotation_id"/></list></field></record>
    <record id="view_custom_sales_inquiry_form" model="ir.ui.view"><field name="name">custom.sales.inquiry.form</field><field name="model">custom.sales.inquiry</field><field name="arch" type="xml"><form><header><button name="action_send" type="object" string="Send" invisible="state != 'draft'"/><button name="action_accept" type="object" string="Accept and Create Quotation" class="btn-primary" invisible="state not in ('draft', 'sent')"/><button name="action_reject" type="object" string="Reject" invisible="state in ('accepted', 'rejected')"/><button name="action_view_quotation" type="object" string="Quotation" invisible="not quotation_id"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="date"/><field name="company_id"/><field name="partner_id"/><field name="user_id"/><field name="quotation_id" readonly="1"/></group><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="description"/><field name="quantity"/><field name="price_unit"/></list></field><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_custom_sales_inquiry" model="ir.actions.act_window"><field name="name">Sales Inquiries</field><field name="res_model">custom.sales.inquiry</field><field name="view_mode">list,form</field></record>

    <record id="view_custom_sales_contract_list" model="ir.ui.view"><field name="name">custom.sales.contract.list</field><field name="model">custom.sales.contract</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="start_date"/><field name="end_date"/><field name="state"/></list></field></record>
    <record id="view_custom_sales_contract_form" model="ir.ui.view"><field name="name">custom.sales.contract.form</field><field name="model">custom.sales.contract</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/><button name="action_release_order" type="object" string="Release Sales Order" invisible="state != 'active'"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="start_date"/><field name="end_date"/></group><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="description"/><field name="quantity"/><field name="price_unit"/></list></field><field name="terms"/><field name="sale_order_ids" readonly="1"/></sheet><chatter/></form></field></record>
    <record id="action_custom_sales_contract" model="ir.actions.act_window"><field name="name">Sales Contracts</field><field name="res_model">custom.sales.contract</field><field name="view_mode">list,form</field></record>

    <record id="view_custom_scheduling_agreement_list" model="ir.ui.view"><field name="name">custom.sales.scheduling.agreement.list</field><field name="model">custom.sales.scheduling.agreement</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="contract_id"/><field name="validity_date"/><field name="state"/></list></field></record>
    <record id="view_custom_scheduling_agreement_form" model="ir.ui.view"><field name="name">custom.sales.scheduling.agreement.form</field><field name="model">custom.sales.scheduling.agreement</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/><button name="action_release_order" type="object" string="Release Sales Order" invisible="state != 'active'"/><button name="action_close" type="object" string="Close" invisible="state == 'closed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="contract_id"/><field name="validity_date"/></group><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="description"/><field name="quantity"/><field name="price_unit"/></list></field><field name="sale_order_ids" readonly="1"/></sheet><chatter/></form></field></record>
    <record id="action_custom_scheduling_agreement" model="ir.actions.act_window"><field name="name">Scheduling Agreements</field><field name="res_model">custom.sales.scheduling.agreement</field><field name="view_mode">list,form</field></record>

    <record id="view_custom_purchase_request_list" model="ir.ui.view"><field name="name">custom.purchase.request.list</field><field name="model">custom.purchase.request</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="requester_id"/><field name="vendor_id"/><field name="state"/><field name="purchase_order_id"/></list></field></record>
    <record id="view_custom_purchase_request_form" model="ir.ui.view"><field name="name">custom.purchase.request.form</field><field name="model">custom.purchase.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'"/><button name="action_create_rfq" type="object" string="Create RFQ" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="date"/><field name="company_id"/><field name="requester_id"/><field name="vendor_id"/><field name="purchase_order_id" readonly="1"/></group><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="description"/><field name="quantity"/><field name="price_unit"/></list></field><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_custom_purchase_request" model="ir.actions.act_window"><field name="name">Purchase Requests</field><field name="res_model">custom.purchase.request</field><field name="view_mode">list,form</field></record>

    <record id="view_custom_sales_return_list" model="ir.ui.view"><field name="name">custom.sales.return.request.list</field><field name="model">custom.sales.return.request</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="original_picking_id"/><field name="return_picking_id"/><field name="state"/></list></field></record>
    <record id="view_custom_sales_return_form" model="ir.ui.view"><field name="name">custom.sales.return.request.form</field><field name="model">custom.sales.return.request</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" invisible="state != 'draft'"/><button name="action_create_return" type="object" string="Create Return Delivery" class="btn-primary" invisible="state != 'approved'"/><button name="action_create_credit_note" type="object" string="Create Credit Note" invisible="state not in ('approved', 'done') or not invoice_id or credit_note_id"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="original_picking_id"/><field name="return_picking_id" readonly="1"/><field name="invoice_id"/><field name="credit_note_id" readonly="1"/><field name="reason"/></group></sheet><chatter/></form></field></record>
    <record id="action_custom_sales_return" model="ir.actions.act_window"><field name="name">Sales Returns</field><field name="res_model">custom.sales.return.request</field><field name="view_mode">list,form</field></record>

    <record id="view_custom_sales_waybill_list" model="ir.ui.view"><field name="name">custom.sales.waybill.list</field><field name="model">custom.sales.waybill</field><field name="arch" type="xml"><list><field name="name"/><field name="picking_id"/><field name="partner_id"/><field name="number"/><field name="state"/><field name="provider"/></list></field></record>
    <record id="view_custom_sales_waybill_form" model="ir.ui.view"><field name="name">custom.sales.waybill.form</field><field name="model">custom.sales.waybill</field><field name="arch" type="xml"><form><header><button name="action_request" type="object" string="Request" invisible="state != 'draft'"/><button name="action_receive" type="object" string="Mark Received" class="btn-primary" invisible="state != 'requested'"/><button name="action_validate" type="object" string="Validate Number" invisible="state not in ('requested', 'received')"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="picking_id"/><field name="partner_id" readonly="1"/><field name="provider"/><field name="number"/><field name="validated_by" readonly="1"/><field name="validated_at" readonly="1"/><field name="request_payload"/><field name="response_payload"/><field name="error_message"/></group></sheet><chatter/></form></field></record>

    <record id="view_custom_sales_debit_memo_list" model="ir.ui.view"><field name="name">custom.sales.debit.memo.list</field><field name="model">custom.sales.debit.memo</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="original_invoice_id"/><field name="amount"/><field name="state"/><field name="debit_note_id"/></list></field></record>
    <record id="view_custom_sales_debit_memo_form" model="ir.ui.view"><field name="name">custom.sales.debit.memo.form</field><field name="model">custom.sales.debit.memo</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'"/><button name="action_post" type="object" string="Post Debit Note" class="btn-primary" invisible="state != 'confirmed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="partner_id"/><field name="original_invoice_id"/><field name="amount"/><field name="debit_note_id" readonly="1"/><field name="reason"/></group></sheet><chatter/></form></field></record>
    <record id="action_custom_sales_debit_memo" model="ir.actions.act_window"><field name="name">Debit Memos</field><field name="res_model">custom.sales.debit.memo</field><field name="view_mode">list,form</field></record>
    <record id="action_custom_sales_waybill" model="ir.actions.act_window"><field name="name">Waybills / E-way Boundary</field><field name="res_model">custom.sales.waybill</field><field name="view_mode">list,form</field></record>

    <record id="view_sale_order_plan_completion" model="ir.ui.view"><field name="name">sale.order.plan.completion</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="custom_contract_id"/><field name="custom_scheduling_agreement_id"/><field name="is_free_of_charge"/><field name="foc_type" invisible="not is_free_of_charge"/><field name="foc_reason" invisible="not is_free_of_charge"/></xpath></field></record>
    <record id="view_purchase_order_plan_completion" model="ir.ui.view"><field name="name">purchase.order.plan.completion</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_id']" position="after"><field name="custom_purchase_request_id"/><field name="goods_available"/><field name="backorder_required"/></xpath></field></record>
</odoo>
