<odoo>
    <record id="view_custom_accounting_close_list" model="ir.ui.view"><field name="name">custom.accounting.close.list</field><field name="model">custom.accounting.close</field><field name="arch" type="xml"><list><field name="name"/><field name="close_type"/><field name="date_from"/><field name="date_to"/><field name="company_id"/><field name="state"/><field name="exception_count"/></list></field></record>
    <record id="view_custom_accounting_close_form" model="ir.ui.view"><field name="name">custom.accounting.close.form</field><field name="model">custom.accounting.close</field><field name="arch" type="xml"><form><header><button name="action_run_checks" type="object" string="Run Checks" invisible="state not in ('draft', 'review')"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'review'"/><button name="action_generate_closing_entry" type="object" string="Generate Closing Entry" invisible="state not in ('approved', 'locked') or closing_move_id"/><button name="action_lock" type="object" string="Lock Period" invisible="state != 'approved'"/><button name="action_prepare_next_year" type="object" string="Prepare Next Year" invisible="close_type != 'year' or state != 'locked' or carryforward_done"/><button name="action_view_closing_move" type="object" string="Closing Entry" invisible="not closing_move_id"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="close_type"/><field name="date_from"/><field name="date_to"/></group><group string="Checklist"><field name="sales_reviewed"/><field name="purchase_reviewed"/><field name="bank_reconciled"/><field name="asset_deferred_reviewed"/><field name="reports_reviewed"/><field name="controller_approved"/></group><group string="Closing Entry"><field name="journal_id"/><field name="retained_earnings_account_id"/><field name="closing_move_id" readonly="1"/><field name="opening_move_id" readonly="1"/></group><group string="Next-Year Carry-forward"><field name="carryforward_done" readonly="1"/><field name="carried_budget_ids" readonly="1"/><field name="carried_recurring_ids" readonly="1"/></group><group string="Automated Checks"><field name="exception_count" readonly="1"/><field name="exception_summary" readonly="1"/></group><field name="attachment_ids" widget="many2many_binary"/><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_custom_accounting_close" model="ir.actions.act_window"><field name="name">Period Close</field><field name="res_model">custom.accounting.close</field><field name="view_mode">list,form</field></record>
</odoo>
