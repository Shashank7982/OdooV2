<odoo>
    <record id="view_custom_desk_configuration_list" model="ir.ui.view"><field name="name">custom.desk.configuration.list</field><field name="model">custom.desk.configuration</field><field name="arch" type="xml"><list><field name="name"/><field name="product_tmpl_id"/><field name="sale_order_line_id"/><field name="width_mm"/><field name="depth_mm"/><field name="height_mm"/><field name="state"/></list></field></record>
    <record id="view_custom_desk_configuration_form" model="ir.ui.view"><field name="name">custom.desk.configuration.form</field><field name="model">custom.desk.configuration</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="product_tmpl_id"/><field name="sale_order_line_id"/></group><group string="Dimensions"><field name="width_mm"/><field name="depth_mm"/><field name="height_mm"/><field name="material"/><field name="finish"/><field name="cable_tray"/><field name="drawer_count"/><field name="price_adjustment"/></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_custom_desk_configuration" model="ir.actions.act_window"><field name="name">Desk Configurations</field><field name="res_model">custom.desk.configuration</field><field name="view_mode">list,form</field></record>
    <record id="view_sale_order_line_desk_configuration" model="ir.ui.view"><field name="name">sale.order.line.desk.configuration</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after"><field name="desk_configuration_id" invisible="not product_id.product_tmpl_id.is_custom_desk"/></xpath><xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="after"><field name="is_free_of_charge"/><field name="foc_reason" invisible="not is_free_of_charge"/></xpath></field></record>
    <record id="view_product_template_custom_desk" model="ir.ui.view"><field name="name">product.template.custom.desk</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_form_view"/><field name="arch" type="xml"><xpath expr="//field[@name='sale_ok']" position="after"><field name="is_custom_desk"/></xpath></field></record>
</odoo>
