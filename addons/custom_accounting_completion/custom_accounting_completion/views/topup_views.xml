<odoo>
    <record id="view_account_petty_cash_topup_list" model="ir.ui.view"><field name="name">account.petty.cash.topup.list</field><field name="model">account.petty.cash.topup</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="location_id"/><field name="funding_journal_id"/><field name="amount"/><field name="state"/><field name="move_id"/></list></field></record>
    <record id="view_account_petty_cash_topup_form" model="ir.ui.view"><field name="name">account.petty.cash.topup.form</field><field name="model">account.petty.cash.topup</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" invisible="state not in ('draft', 'submitted')"/><button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'approved'"/><button name="action_view_move" type="object" string="Journal Entry" invisible="not move_id"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="date"/><field name="location_id"/><field name="cash_journal_id" readonly="1"/><field name="funding_journal_id"/><field name="amount"/><field name="reference"/><field name="move_id" readonly="1"/></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="action_account_petty_cash_topup" model="ir.actions.act_window"><field name="name">Petty Cash Top-ups</field><field name="res_model">account.petty.cash.topup</field><field name="view_mode">list,form</field></record>
</odoo>
