<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_csv_import_wizard_form" model="ir.ui.view">
        <field name="name">bank.statement.csv.import.wizard.form</field>
        <field name="model">bank.statement.csv.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    CSV/XLSX must have columns: <b>date, label, amount</b>, and optionally
                    <b>partner_name, reference</b>. One row per bank transaction.
                    <button name="action_download_template" type="object"
                            string="Download Sample CSV Template" class="btn-link" icon="fa-download"/>
                    <button name="action_download_template_xlsx" type="object"
                            string="Download Sample XLSX Template" class="btn-link" icon="fa-download"/>
                </p>
                <group>
                    <group>
                        <field name="journal_id"/>
                        <field name="date_format"/>
                        <field name="delimiter"/>
                        <field name="skip_duplicates"/>
                    </group>
                    <group>
                        <field name="csv_file" filename="csv_filename"/>
                        <field name="csv_filename" invisible="1"/>
                        <field name="file_type" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group invisible="not import_log" col="4">
                    <field name="imported_count" string="Imported"/>
                    <field name="skipped_count" string="Skipped (duplicates)"/>
                    <field name="error_count" string="Errors"/>
                    <field name="imported_total" string="Imported Total" widget="monetary"/>
                </group>
                <separator string="Preview" invisible="not preview_line_ids"/>
                <field name="preview_line_ids" readonly="1" invisible="not preview_line_ids">
                    <list decoration-danger="status == 'error'" decoration-warning="status == 'duplicate'">
                        <field name="row_number"/>
                        <field name="date"/>
                        <field name="label"/>
                        <field name="amount"/>
                        <field name="partner_id"/>
                        <field name="reference"/>
                        <field name="status"/>
                        <field name="error_message"/>
                    </list>
                </field>
                <field name="import_log" readonly="1" invisible="not import_log"/>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary" invisible="preview_state != 'ready'"/>
                    <button name="action_view_imported" type="object" string="View Imported Transactions" class="btn-secondary" invisible="not imported_count"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_statement_csv_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Bank Statement (CSV)</field>
        <field name="res_model">bank.statement.csv.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
