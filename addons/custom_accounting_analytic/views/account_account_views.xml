<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_require_analytic" model="ir.ui.view">
        <field name="name">account.account.form.require.analytic</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allowed_journal_ids']" position="after">
                <field name="require_analytic_distribution"/>
            </xpath>
        </field>
    </record>
</odoo>
