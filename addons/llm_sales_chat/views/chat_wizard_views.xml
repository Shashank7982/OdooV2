<odoo>
    <record id="view_llm_chat_wizard_form" model="ir.ui.view">
        <field name="name">llm.chat.wizard.form</field>
        <field name="model">llm.chat.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="question" placeholder="e.g. How many open leads do we have?"/>
                    </group>
                    <group string="Answer" invisible="not answer">
                        <field name="answer" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_ask" type="object" string="Ask" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_llm_chat_wizard" model="ir.actions.act_window">
        <field name="name">Ask Sales &amp; CRM Chatbot</field>
        <field name="res_model">llm.chat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_llm_chat_wizard"
              name="AI Chat Assistant"
              action="action_llm_chat_wizard"
              parent="sale.sale_menu_root"
              sequence="100"/>
</odoo>
