<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_category_form" model="ir.ui.view">
        <field name="name">account.asset.category.form</field>
        <field name="model">account.asset.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="asset_type"/>
                            <field name="method"/>
                            <field name="duration_months" invisible="method != 'linear'"/>
                            <field name="declining_rate" invisible="method != 'declining'"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="asset_account_id"/>
                            <field name="depreciation_account_id"/>
                            <field name="expense_account_id"/>
                            <field name="gain_account_id"/>
                            <field name="loss_account_id"/>
                            <field name="revaluation_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_account_asset_category_list" model="ir.ui.view">
        <field name="name">account.asset.category.list</field>
        <field name="model">account.asset.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="method"/>
                <field name="asset_account_id"/>
                <field name="depreciation_account_id"/>
                <field name="expense_account_id"/>
            </list>
        </field>
    </record>
    <record id="action_account_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">account.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
