<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_transfer_wizard_form" model="ir.ui.view">
        <field name="name">account.asset.transfer.wizard.form</field>
        <field name="model">account.asset.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Asset">
                <group>
                    <field name="asset_id" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="analytic_account_id"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Transfer" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
