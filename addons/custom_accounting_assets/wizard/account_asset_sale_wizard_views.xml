<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_sale_wizard_form" model="ir.ui.view">
        <field name="name">account.asset.sale.wizard.form</field>
        <field name="model">account.asset.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Sell Asset">
                <group>
                    <field name="asset_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="sale_date"/>
                    <field name="sale_price"/>
                    <field name="proceeds_account_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Sale" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
