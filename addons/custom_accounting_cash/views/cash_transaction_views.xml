<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_cash_transaction" model="ir.ui.view">
        <field name="name">sale.order.form.cash.transaction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="transaction_mode"/>
                <field name="cash_journal_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_location_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_payment_method" invisible="transaction_mode != 'cash'"/>
                <field name="cash_receipt_ref" invisible="transaction_mode != 'cash'"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_cash_transaction" model="ir.ui.view">
        <field name="name">purchase.order.form.cash.transaction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="transaction_mode"/>
                <field name="cash_journal_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_location_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_payment_method" invisible="transaction_mode != 'cash'"/>
                <field name="cash_receipt_ref" invisible="transaction_mode != 'cash'"/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_cash_transaction" model="ir.ui.view">
        <field name="name">account.move.form.cash.transaction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="transaction_mode"/>
                <field name="cash_journal_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_location_id" invisible="transaction_mode != 'cash'"/>
                <field name="cash_payment_method" invisible="transaction_mode != 'cash'"/>
                <field name="cash_receipt_ref" invisible="transaction_mode != 'cash'"/>
                <field name="cash_payment_id" readonly="1" invisible="not cash_payment_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_petty_cash_voucher_list" model="ir.ui.view">
        <field name="name">account.petty.cash.voucher.list</field>
        <field name="model">account.petty.cash.voucher</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'" decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="custodian_id"/>
                <field name="payee_name"/>
                <field name="purpose"/>
                <field name="amount" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_account_petty_cash_voucher_form" model="ir.ui.view">
        <field name="name">account.petty.cash.voucher.form</field>
        <field name="model">account.petty.cash.voucher</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="account.group_account_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="account.group_account_manager"/>
                    <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'approved'" groups="account.group_account_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('submitted', 'approved', 'rejected')"/>
                    <button name="action_view_move" type="object" string="Journal Entry" invisible="not move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="date"/><field name="location_id"/><field name="custodian_id" readonly="1"/></group>
                        <group><field name="company_id"/><field name="journal_id" readonly="1"/><field name="amount"/></group>
                    </group>
                    <group string="Expense Details">
                        <field name="partner_id"/><field name="payee_name"/><field name="purpose"/><field name="expense_account_id"/><field name="tax_ids" widget="many2many_tags"/>
                    </group>
                    <group><field name="receipt" filename="receipt_filename"/><field name="receipt_filename" invisible="1"/><field name="notes"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_account_petty_cash_voucher" model="ir.actions.act_window">
        <field name="name">Petty Cash Vouchers</field>
        <field name="res_model">account.petty.cash.voucher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
