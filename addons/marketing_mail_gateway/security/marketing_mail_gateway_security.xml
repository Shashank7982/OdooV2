<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing_mail_gateway" model="ir.module.category">
        <field name="name">Marketing Mail Gateway</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_marketing_mail_gateway_user" model="res.groups">
        <field name="name">User: read inbound marketing mail log</field>
        <field name="category_id" ref="module_category_marketing_mail_gateway"/>
        <field name="implied_ids" eval="[(4, ref('mass_mailing.group_mass_mailing_user'))]"/>
    </record>

    <record id="group_marketing_mail_gateway_manager" model="res.groups">
        <field name="name">Manager: configure marketing mailboxes</field>
        <field name="category_id" ref="module_category_marketing_mail_gateway"/>
        <field name="implied_ids" eval="[(4, ref('group_marketing_mail_gateway_user')), (4, ref('mass_mailing.group_mass_mailing_campaign'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="marketing_inbound_mail_rule_user" model="ir.rule">
        <field name="name">Marketing Inbound Mail: users see all (single company data)</field>
        <field name="model_id" ref="model_marketing_inbound_mail"/>
        <field name="groups" eval="[(4, ref('group_marketing_mail_gateway_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
