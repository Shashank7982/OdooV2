<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="discuss.ChannelInvitation" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-discuss-ChannelInvitation-invitationBox')]" position="before">
            <div t-if="meetingCredentialsByThreadId[props.thread.id]" class="border-top border-bottom p-2 mb-2 bg-100">
                <div class="small fw-bold mb-1">Meeting credentials</div>
                <div class="d-flex gap-1 mb-2"><span class="small text-muted flex-grow-1 align-self-center">Guests wait for host admission.</span><button t-if="!meetingCredentialsByThreadId[props.thread.id].open" class="btn btn-sm btn-primary" t-on-click="openMeeting">Open meeting</button><button t-else="" class="btn btn-sm btn-outline-warning" t-on-click="closeMeeting">Close for new joiners</button><button class="btn btn-sm btn-outline-secondary" t-on-click="refreshPending">Refresh</button></div>
                <div class="mb-2"><div class="small fw-bold">Waiting guests</div><div t-if="!pendingGuests.length" class="small text-muted py-1">No guests waiting for admission.</div><t t-foreach="pendingGuests" t-as="guest" t-key="guest.id"><div class="d-flex align-items-center justify-content-between small py-1"><span t-esc="guest.name"/><button class="btn btn-sm btn-success" t-on-click="() => this.admitGuest(guest.id)">Admit</button></div></t></div>
                <div class="input-group input-group-sm mb-1">
                    <span class="input-group-text">ID</span>
                    <input class="form-control" readonly="readonly" t-att-value="meetingCredentialsByThreadId[props.thread.id].meeting_id"/>
                    <button class="btn btn-outline-secondary" t-on-click="() => this.copyMeetingCredential(meetingCredentialsByThreadId[props.thread.id].meeting_id, 'Meeting ID')"><i class="fa fa-copy"/></button>
                </div>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">Password</span>
                    <input class="form-control" readonly="readonly" t-att-value="meetingCredentialsByThreadId[props.thread.id].password"/>
                    <button class="btn btn-outline-secondary" t-on-click="() => this.copyMeetingCredential(meetingCredentialsByThreadId[props.thread.id].password, 'Meeting password')"><i class="fa fa-copy"/></button>
                </div>
                <div t-if="meetingCredentialsByThreadId[props.thread.id].dialin_enabled" class="mt-2 p-2 bg-white border rounded">
                    <div class="small fw-bold">Join by phone</div>
                    <div class="small text-muted">Call <strong t-esc="meetingCredentialsByThreadId[props.thread.id].dialin_number"/> and enter PIN <strong t-esc="meetingCredentialsByThreadId[props.thread.id].dialin_pin"/>.</div>
                    <button class="btn btn-sm btn-outline-secondary mt-1" t-on-click="() => this.copyMeetingCredential(meetingCredentialsByThreadId[props.thread.id].dialin_number, 'Dial-in number')"><i class="fa fa-copy me-1"/>Copy number</button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
