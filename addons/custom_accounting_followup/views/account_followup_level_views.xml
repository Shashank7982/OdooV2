<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_followup_level_list" model="ir.ui.view">
        <field name="name">account.followup.level.list</field>
        <field name="model">account.followup.level</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="delay_days"/>
                <field name="action"/>
                <field name="mail_template_id"/>
                <field name="activity_type_id"/>
            </list>
        </field>
    </record>

    <record id="action_account_followup_level" model="ir.actions.act_window">
        <field name="name">Follow-up Levels</field>
        <field name="res_model">account.followup.level</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
