<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bank Reports: bank/cash journal items only. List/Pivot/Graph natively
         support CSV/XLSX export and respect the user's normal record access
         rules - no separate report engine needed for this. "Bank balance" /
         "Bank statement summary" / "Date-wise" / "Bank account-wise" are all
         just pivot group-by combinations (Journal x Date, measure Balance). -->
    <record id="view_bank_reports_search" model="ir.ui.view">
        <field name="name">bank.reports.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="account_id"/>
                <field name="date"/>
                <filter string="Deposits" name="filter_deposits" domain="[('debit', '>', 0)]"/>
                <filter string="Withdrawals" name="filter_withdrawals" domain="[('credit', '>', 0)]"/>
                <separator/>
                <filter string="Reconciled" name="filter_reconciled" domain="[('reconciled', '=', True)]"/>
                <filter string="Unreconciled" name="filter_unreconciled" domain="[('reconciled', '=', False)]"/>
                <separator/>
                <filter string="Posted" name="filter_posted" domain="[('parent_state', '=', 'posted')]"/>
                <filter string="Draft" name="filter_draft" domain="[('parent_state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Bank Account / Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_reports" model="ir.actions.act_window">
        <field name="name">Bank Reports</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_bank_reports_search"/>
        <field name="domain">[('journal_id.type', 'in', ('bank', 'cash')), ('display_type', 'not in', ('line_section', 'line_note'))]</field>
        <field name="context">{'search_default_group_journal': 1, 'search_default_filter_posted': 1}</field>
    </record>

    <!-- Transaction Reports: every accounting transaction, unrestricted -
         journal entries, customer invoices, vendor bills, credit notes,
         payments, refunds, cash/bank transactions. Filterable by date,
         journal, account, partner, transaction type, company, currency,
         posted/draft, and user (salesperson / created by). "Debit note" is
         not a distinct Odoo document type - vendor credit notes (in_refund)
         cover that use case, included under Vendor Credit Notes below. -->
    <record id="view_transaction_reports_search" model="ir.ui.view">
        <field name="name">transaction.reports.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="date"/>
                <filter string="Customer Invoices" name="filter_out_invoice" domain="[('move_id.move_type', '=', 'out_invoice')]"/>
                <filter string="Credit Notes" name="filter_out_refund" domain="[('move_id.move_type', '=', 'out_refund')]"/>
                <filter string="Vendor Bills" name="filter_in_invoice" domain="[('move_id.move_type', '=', 'in_invoice')]"/>
                <filter string="Vendor Credit Notes / Refunds" name="filter_in_refund" domain="[('move_id.move_type', '=', 'in_refund')]"/>
                <filter string="Journal Entries" name="filter_entry" domain="[('move_id.move_type', '=', 'entry')]"/>
                <separator/>
                <filter string="Cash Transactions" name="filter_cash" domain="[('journal_id.type', '=', 'cash')]"/>
                <filter string="Bank Transactions" name="filter_bank" domain="[('journal_id.type', '=', 'bank')]"/>
                <separator/>
                <filter string="Posted" name="filter_posted" domain="[('parent_state', '=', 'posted')]"/>
                <filter string="Draft" name="filter_draft" domain="[('parent_state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Created By" name="group_create_uid" context="{'group_by': 'create_uid'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_transaction_reports" model="ir.actions.act_window">
        <field name="name">Transaction Reports</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_transaction_reports_search"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_note'))]</field>
        <field name="context">{'search_default_filter_posted': 1}</field>
    </record>

</odoo>
