<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aged_partner_report_wizard_form" model="ir.ui.view">
        <field name="name">aged.partner.report.wizard.form</field>
        <field name="model">aged.partner.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="as_of_date"/>
                        </group>
                    </group>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary mb-3"/>
                    <field name="line_ids">
                        <list create="false" delete="false">
                            <field name="partner_id"/>
                            <field name="not_due" sum="Total"/>
                            <field name="due_1_30" sum="Total"/>
                            <field name="due_31_60" sum="Total"/>
                            <field name="due_61_90" sum="Total"/>
                            <field name="due_90_plus" sum="Total"/>
                            <field name="total" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_not_due"/>
                        <field name="total_1_30"/>
                        <field name="total_31_60"/>
                        <field name="total_61_90"/>
                        <field name="total_90_plus"/>
                        <field name="total_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aged_partner_report_wizard_list" model="ir.ui.view">
        <field name="name">aged.partner.report.wizard.list</field>
        <field name="model">aged.partner.report.wizard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="as_of_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="total_amount"/>
                <field name="create_date" string="Generated On"/>
            </list>
        </field>
    </record>

    <record id="action_aged_partner_report_wizard" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">aged.partner.report.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('report_type', '=', 'receivable')]</field>
        <field name="context">{'default_report_type': 'receivable'}</field>
    </record>

    <record id="action_aged_payable_report_wizard" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">aged.partner.report.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('report_type', '=', 'payable')]</field>
        <field name="context">{'default_report_type': 'payable'}</field>
    </record>
</odoo>
