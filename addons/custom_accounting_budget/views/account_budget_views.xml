<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_budget_form" model="ir.ui.view">
        <field name="name">account.budget.form</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Marketing Dept - FY2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="analytic_account_id"/>
                            <field name="budget_type"/>
                            <field name="period_type"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="budgeted_amount"/>
                            <field name="committed_amount"/>
                        </group>
                        <group>
                            <field name="actual_amount"/>
                            <field name="remaining_amount"/>
                            <field name="variance_amount"/>
                            <field name="variance_percent" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revision History" name="revisions">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="old_amount"/>
                                    <field name="new_amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_budget_list" model="ir.ui.view">
        <field name="name">account.budget.list</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <list decoration-danger="variance_amount > 0 and budget_type == 'expense'">
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="budget_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="budgeted_amount" sum="Total"/>
                <field name="actual_amount" sum="Total"/>
                <field name="variance_amount" sum="Total"/>
                <field name="variance_percent" widget="percentage"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_account_budget_pivot" model="ir.ui.view">
        <field name="name">account.budget.pivot</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <pivot string="Budget vs Actual">
                <field name="analytic_account_id" type="row"/>
                <field name="budgeted_amount" type="measure"/>
                <field name="committed_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="remaining_amount" type="measure"/>
                <field name="variance_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_budget_graph" model="ir.ui.view">
        <field name="name">account.budget.graph</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <graph string="Budget vs Actual Dashboard" type="bar">
                <field name="name" type="row"/>
                <field name="budgeted_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_account_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">list,pivot,form</field>
    </record>

    <record id="action_account_budget_dashboard" model="ir.actions.act_window">
        <field name="name">Budget vs Actual Dashboard</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>
</odoo>
