<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Set the V2 Home Menu as the default home action for the
        Administrator user (uid=1). After installation, every other
        user can be pointed here via Settings > Users > Action.
        We use a post-install hook style data record here.
    -->
    <function model="res.users" name="write">
        <value eval="[1]"/>
        <value eval="{'action_id': ref('v2_home_menu.action_v2_home_menu')}"/>
    </function>
</odoo>
