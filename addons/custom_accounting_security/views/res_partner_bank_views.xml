<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_restricted" model="ir.ui.view">
        <field name="name">res.partner.bank.form.accounting.security</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acc_number']" position="attributes">
                <attribute name="groups">custom_accounting_security.group_accounting_finance_controller</attribute>
            </xpath>
            <xpath expr="//field[@name='acc_holder_name']" position="attributes">
                <attribute name="groups">custom_accounting_security.group_accounting_finance_controller</attribute>
            </xpath>
        </field>
    </record>
</odoo>
