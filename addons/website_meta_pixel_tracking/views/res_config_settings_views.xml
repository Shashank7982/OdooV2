<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_meta_pixel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.meta.pixel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Meta Pixel Tracking" id="meta_pixel_setting_container">
                    <setting id="meta_pixel_setting" string="Meta Pixel"
                             help="Tracks page views, purchases and leads on this website via the Meta Pixel">
                        <field name="meta_pixel_id" placeholder="e.g. 1234567890123456"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
