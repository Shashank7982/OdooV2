<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="custom_home_desk_app.HomeMenu" t-inherit="web_enterprise.HomeMenu" t-inherit-mode="extension" owl="1">
    <xpath expr="//div[hasclass('o_home_menu')]" position="attributes">
        <attribute name="class">o_home_menu h-100 overflow-y-auto</attribute>
        <attribute name="style"></attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="attributes">
        <attribute name="class">container-fluid o_home_menu_workspace px-4 px-md-5</attribute>
    </xpath>

    <xpath expr="//input[@t-ref='input']" position="replace">
        <div class="o_home_menu_header text-center mt-5">
            <div id="o_home_menu_clock" class="o_home_menu_clock display-1 fw-bold text-white mb-4">
                <t t-esc="state.currentTime"/>
            </div>
            <div class="o_home_menu_search_container mb-4 px-3" t-ref="search_container">
                <input t-ref="input" type="text" class="form-control form-control-lg rounded-pill o_custom_search"
                    role="combobox"
                    t-att-aria-expanded="state.isSearchDropdownOpen ? 'true' : 'false'"
                    aria-autocomplete="list"
                    aria-haspopup="listbox"
                    autocomplete="off"
                    placeholder="Search apps..."
                    t-on-input="_onInputSearch"
                    t-on-blur="_onInputBlur"
                    t-on-focus="_onInputFocus"
                    t-on-keydown="_onInputKeydown"
                    t-on-compositionstart="_onCompositionStart"
                />
                
                <div class="dropdown o_home_menu_filter ms-2">
                    <button class="btn btn-light rounded-pill p-2 d-flex align-items-center justify-content-center shadow-none border-0" 
                            type="button" 
                            id="filterMenuButton" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false">
                        <i class="oi oi-settings-adjust fs-5"/>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-2" aria-labelledby="filterMenuButton" style="border-radius: 15px;">
                        <li><h6 class="dropdown-header">Sort Apps By</h6></li>
                        <li><button class="dropdown-item rounded-3 py-2" type="button" t-on-click="() => this._sortApps('az')"><i class="fa fa-sort-alpha-asc me-2"/>Name (A-Z)</button></li>
                        <li><button class="dropdown-item rounded-3 py-2" type="button" t-on-click="() => this._sortApps('za')"><i class="fa fa-sort-alpha-desc me-2"/>Name (Z-A)</button></li>
                        <t t-if="env.isSmall">
                            <li><hr class="dropdown-divider"/></li>
                            <li><button class="dropdown-item rounded-3 py-2" type="button" t-on-click="_toggleEditMode">
                                <i t-att-class="state.isEditMode ? 'fa fa-lock me-2' : 'fa fa-pencil me-2'"/>
                                <t t-esc="state.isEditMode ? 'Disable Editing' : 'Customize Layout'"/>
                            </button></li>
                            <li t-if="state.isEditMode"><button class="dropdown-item rounded-3 py-2 text-primary fw-bold" type="button" t-on-click="_saveLayoutAndExitEdit">
                                <i class="fa fa-save me-2"/>Save Layout
                            </button></li>
                        </t>
                        <li><hr class="dropdown-divider"/></li>
                        <li><button class="dropdown-item rounded-3 py-2 text-danger" type="button" t-on-click="() => this._sortApps('reset')"><i class="fa fa-refresh me-2"/>Reset to Default</button></li>
                    </ul>
                </div>

                <div t-if="state.isSearchDropdownOpen" id="home_search_dropdown" class="o_home_menu_search_dropdown shadow-lg" role="listbox">
                    <button t-foreach="state.searchResults" t-as="result" t-key="result.key"
                        t-att-id="'home_search_result_' + result_index"
                        type="button"
                        class="o_home_menu_search_result btn text-start w-100 border-0 rounded-0"
                        t-att-class="{ o_selected: state.searchResultIndex === result_index }"
                        t-on-mousedown.prevent="() => this._selectSearchResult(result)"
                        t-on-click.prevent="() => this._selectSearchResult(result)">
                        <div class="o_home_menu_search_result_label" t-esc="result.label"/>
                        <div t-if="result.parents" class="o_home_menu_search_result_parents text-muted small" t-esc="result.parents"/>
                        <div t-else="" class="o_home_menu_search_result_type text-muted small" t-esc="result.type === 'app' ? 'Application' : 'Menu'"/>
                    </button>
                    <div t-if="!state.searchResults.length" class="o_home_menu_search_empty px-4 py-3 text-muted">
                        No result
                    </div>
                </div>
            </div>
        </div>
    </xpath>

    <xpath expr="//div[hasclass('o_apps')]" position="replace">
        <div t-if="displayedApps.length" role="listbox" class="o_apps o_apps_canvas user-select-none mx-0" t-ref="apps_canvas" t-att-style="'height: ' + state.canvasHeight + 'px;'">
            <div t-foreach="displayedApps" t-as="app" t-key="app.id"
                class="o_draggable o_free_draggable"
                t-att-class="{ o_dragging: state.draggedAppXmlid === app.xmlid, o_editable: state.isEditMode }"
                t-att-style="_getAppStyle(app, app_index)"
                t-on-pointerdown="(ev) => this._onAppPointerDown(ev, app)"
                t-on-dragstart.prevent="">
                <a t-att-id="'result_app_' + app_index"
                    role="option"
                    t-att-aria-selected="state.focusedIndex === app_index ? 'true' : 'false'"
                    class="o_app o_menuitem d-flex flex-column rounded-4 justify-content-start align-items-center h-100 w-100 p-2"
                    t-att-class="{ o_focused: state.focusedIndex === app_index }"
                    t-att-data-menu-xmlid="app.xmlid"
                    t-att-href="app.href"
                    t-on-click.prevent="() => this.onAppClick(app)">
                    <img t-if="app.webIconData" class="o_app_icon rounded-4"
                        t-attf-src="{{ app.webIconData }}"
                    />
                    <div t-else="" class="o_app_icon position-relative d-flex justify-content-center align-items-center p-2 rounded-4 ratio ratio-1x1"
                        t-attf-style="background-color: {{ app.webIcon.backgroundColor }};">
                        <i t-attf-class="{{ app.webIcon.iconClass }} position-relative w-auto h-auto" t-attf-style="color: {{ app.webIcon.color }};"/>
                    </div>
                    <div class="o_caption w-100 text-center text-truncate mt-2" t-esc="app.label or app.name"/>
                </a>
            </div>
        </div>
    </xpath>
</t>

</templates>
