<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_bill_digitization_form" model="ir.ui.view">
        <field name="name">account.bill.digitization.form</field>
        <field name="model">account.bill.digitization</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_extraction" type="object" string="Run Extraction" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'extracted'"/>
                    <button name="action_create_vendor_bill" type="object" string="Create Vendor Bill" class="btn-primary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,extracted,confirmed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not duplicate_warning">
                        <field name="duplicate_warning" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="provider"/>
                            <field name="document" filename="document_filename"/>
                            <field name="document_filename" invisible="1"/>
                            <button name="action_download_preparation_guide" type="object"
                                    string="Download Bill Preparation Guide" class="btn-link" icon="fa-download"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="tax_amount"/>
                            <field name="total_amount"/>
                        </group>
                        <group>
                            <field name="vendor_bill_id" readonly="1" invisible="not vendor_bill_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_bill_digitization_list" model="ir.ui.view">
        <field name="name">account.bill.digitization.list</field>
        <field name="model">account.bill.digitization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_number"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_account_bill_digitization" model="ir.actions.act_window">
        <field name="name">Vendor Bill Digitization</field>
        <field name="res_model">account.bill.digitization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
