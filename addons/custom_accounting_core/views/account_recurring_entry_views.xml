<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_recurring_entry_form" model="ir.ui.view">
        <field name="name">account.recurring.entry.form</field>
        <field name="model">account.recurring.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_now" type="object" string="Generate Now" class="btn-primary" invisible="not is_balanced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_generated_moves" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="generated_move_count" widget="statinfo" string="Generated Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Monthly Rent"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="ref"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="frequency"/>
                            <field name="start_date"/>
                            <field name="next_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Template Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="partner_id"/>
                                    <field name="name"/>
                                    <field name="debit" sum="Total Debit"/>
                                    <field name="credit" sum="Total Credit"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_debit"/>
                                <field name="total_credit"/>
                                <field name="is_balanced" widget="boolean_toggle" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_recurring_entry_list" model="ir.ui.view">
        <field name="name">account.recurring.entry.list</field>
        <field name="model">account.recurring.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="journal_id"/>
                <field name="frequency"/>
                <field name="next_date"/>
                <field name="end_date"/>
                <field name="is_balanced" widget="boolean_toggle"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_account_recurring_entry" model="ir.actions.act_window">
        <field name="name">Recurring Journal Entries</field>
        <field name="res_model">account.recurring.entry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
