<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_recurring_entry" model="ir.ui.view">
        <field name="name">account.move.form.recurring.entry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='misc_group']" position="inside">
                <field name="recurring_entry_id" invisible="not recurring_entry_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_cash_entries" model="ir.actions.act_window">
        <field name="name">Cash Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('journal_id.type', '=', 'cash')]</field>
        <field name="context">{'default_move_type': 'entry', 'default_journal_id': False, 'search_default_posted': 1}</field>
    </record>
</odoo>
