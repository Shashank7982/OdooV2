<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_generate_recurring_entries" model="ir.cron">
        <field name="name">Custom Accounting: Generate Recurring Journal Entries</field>
        <field name="model_id" ref="model_account_recurring_entry"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_recurring_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_update_exchange_rates" model="ir.cron">
        <field name="name">Custom Accounting: Update Exchange Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._update_rates_from_exchange_api(False)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
