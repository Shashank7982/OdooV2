<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_field_guide_list" model="ir.ui.view">
        <field name="name">account.field.guide.list</field>
        <field name="model">account.field.guide</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="feature_group"/>
                <field name="guide_type"/>
                <field name="model_name"/>
                <field name="menu_path"/>
                <button name="action_download" type="object" string="Download" class="btn-link" icon="fa-download"/>
            </list>
        </field>
    </record>

    <record id="view_account_field_guide_form" model="ir.ui.view">
        <field name="name">account.field.guide.form</field>
        <field name="model">account.field.guide</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_download" type="object" string="Download Guide" class="oe_stat_button" icon="fa-download"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="guide_type"/>
                            <field name="feature_group"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="menu_path"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Fields (one technical field name per line)">
                        <field name="field_names" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_field_guide" model="ir.actions.act_window">
        <field name="name">Field &amp; Upload Guides</field>
        <field name="res_model">account.field.guide</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_field_guide"
              name="Field &amp; Upload Guides"
              parent="account.menu_finance_configuration"
              action="action_account_field_guide"
              sequence="90"/>
</odoo>
